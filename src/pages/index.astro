<style>
    /* 全局背景图与指针 */
    :global(body) {
        background-image: url('/stardew-bg.png'), 
                          linear-gradient(to bottom, #01123c 0%, #06398c 40%, #1d7fc3 70%, #76dbf4 100%);
        background-size: cover;
        background-position: center bottom;
        background-repeat: no-repeat;
        background-attachment: fixed;
        image-rendering: pixelated;
        margin: 0;
        padding: 20px 10px 60px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: url('/stardew-cursor.png'), auto;
    }
    
    .sidebar-item, .map-card, .close-btn, a {
        cursor: url('/stardew-cursor.png'), pointer; 
    }

    /* 顶部挂牌 */
    .stardew-name-sign-wrapper { display: flex; flex-direction: column; align-items: center; margin-bottom: 25px; width: 100%; max-width: 600px; }
    .iron-chains { display: flex; justify-content: space-between; width: 70%; height: 20px; }
    .chain { width: 8px; height: 100%; background: #3a3a3a; border: 2px solid #1a1a1a; box-shadow: 2px 0 0 rgba(0,0,0,0.3); position: relative; }

    .name-sign-body {
        background-color: #5c2304; 
        border: 5px solid #290f01;
        box-shadow: inset -3px -3px 0 #421802, inset 3px 3px 0 #85370d, 0 8px 12px rgba(0,0,0,0.4);
        padding: 12px 30px;
        color: #ffebcc;
        font-size: 1.8rem;
        font-weight: bold;
        text-align: center;
        border-radius: 2px;
        text-shadow: 2px 2px 0px #1c0a00;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        width: 100%;
    }
    .sign-strawberry { font-size: 1.6rem; }

    /* 主布局包装 */
    .game-menu-wrapper { display: flex; width: 100%; max-width: 1200px; align-items: flex-start; gap: 0px; }

    /* 左侧侧边栏 */
    .game-sidebar-nav { display: flex; flex-direction: column; gap: 12px; padding-top: 40px; z-index: 10; }
    .sidebar-item {
        display: flex; align-items: center; gap: 10px; background: #e1b272; border: 4px solid #4a2507;
        border-right: none; color: #3d1c02; font-weight: bold; padding: 14px 18px; font-size: 1.15rem;
        text-decoration: none; border-radius: 12px 0 0 12px;
        box-shadow: -4px 4px 0px rgba(0,0,0,0.2), inset -2px -2px 0 #b08448, inset 2px 2px 0 #ffe3b8;
        transition: all 0.15s ease; min-width: 165px;
    }
    .star-icon { color: #ffcc00; text-shadow: 1px 1px 0 #4a2507; font-size: 1.1rem; transition: color 0.2s ease; }
    .sidebar-item:hover, .sidebar-item.active-tab { background: #fce3bc; transform: translateX(-4px); padding-right: 22px; }
    .sidebar-item.active-tab .star-icon { color: #ff3333; animation: starPulse 0.5s infinite alternate; }

    @keyframes starPulse { 0% { transform: scale(1); } 100% { transform: scale(1.15); } }

    /* 右侧主画布 */
    .game-main-content {
        flex-grow: 1; background: #f1dfb8; border: 6px solid #4a2107;
        box-shadow: inset -4px -4px 0px #ab8d58, inset 4px 4px 0px #fffdf0, 0 12px 24px rgba(0,0,0,0.4);
        padding: 30px; display: flex; flex-direction: column; gap: 35px; border-radius: 4px;
        max-height: 75vh; overflow-y: auto;
    }
    .scroll-section { scroll-margin-top: 25px; }
    .inner-title-ribbon { position: absolute; top: -16px; left: 20px; background: #a65119; color: #fff; border: 3px solid #4a2107; padding: 4px 16px; font-size: 1.2rem; box-shadow: 0 4px 0 rgba(0,0,0,0.15); }
    .content-padding-top { padding-top: 15px; }

    .top-dashboard-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 24px; }

    @media (max-width: 900px) {
        .top-dashboard-grid { grid-template-columns: 1fr; }
        .game-menu-wrapper { flex-direction: column; }
        .game-sidebar-nav { flex-direction: row; flex-wrap: wrap; padding-top: 0; margin-bottom: -4px; width: 100%; }
        .sidebar-item { border-right: 4px solid #4a2507; border-radius: 12px 12px 0 0; min-width: auto; flex-grow: 1; justify-content: center; }
        .game-main-content { max-height: none; }
    }

    /* 🚀 核心修改：双图层头像框体系 */
    .portrait-panel-v2 { background: #cf955a; border: 4px solid #542b0e; padding: 20px; display: flex; align-items: center; justify-content: center; box-shadow: inset -3px -3px 0 #946132, inset 3px 3px 0 #ffcf9e; }
    .avatar-group-container { display: flex; gap: 14px; }
    .pixel-avatar-border { background: #d09459; border: 4px solid #3c1e08; padding: 4px; }
    
    /* 基础空背景框 (Für den linken und rechten Kasten) */
    .avatar-sky-bg {
        width: 70px;
        height: 70px;
        border: 2px solid #221105;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to bottom, #7fc9ff, #2b7bc4); /* Standard blauer Himmel */
    }

    /* Speziell für leere Kästen */
    .empty-bg {
        opacity: 0.5; /* 让两边的空相框变暗变半透明 */
    }

    /* 🚀 激活状态的农夫（你的中间立绘） */
    .active-farmer {
        transform: scale(3.2);
        /* 第一层是你的透明头像 portrait.png，第二层是金色天空背景 */
        background-image: url('/portrait.png'), url('/stardew-bg.png');
        background-size: 85% auto, cover; 
        background-position: center bottom, center; 
        background-repeat: no-repeat, no-repeat;
        
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-position 0.2s ease;
    }

    /* 编程类展示面板样式 */
    .tech-code-container { background: #e3b073; border: 4px solid #542b0e; padding: 24px 20px 16px 20px; position: relative; box-shadow: inset -3px -3px 0 #aa7843, inset 3px 3px 0 #ffe0b5; }
    .panel-inner-tag { position: absolute; top: -10px; left: 14px; background: #542b0e; color: #fff; font-size: 0.85rem; padding: 1px 8px; border-radius: 2px; }
    .pixel-code-screen { background-color: #1c1c1c; border: 3px solid #3c1e08; padding: 14px; color: #e0e0e0; border-radius: 2px; font-size: 0.9rem; overflow-x: auto; box-shadow: inset 0px 4px 8px rgba(0,0,0,0.6); }
    .code-keyword { color: #f97583; }
    .code-class { color: #79b8ff; }
    .code-string { color: #ffea7f; }
    .code-method { color: #b392f0; }

    /* 体力条 */
    .stamina-ui-bar { display: flex; align-items: center; gap: 12px; margin-top: 16px; position: relative; }
    .bar-title { font-weight: bold; font-size: 1rem; color: #3d1c02; }
    .bar-outer { flex-grow: 1; height: 22px; background: #221107; border: 3px solid #542b0e; padding: 2px; }
    .bar-fill { width: 100%; height: 100%; background-color: var(--stardew-green); box-shadow: inset 0 2px 0 rgba(255,255,255,0.2); animation: energyRegen 4s infinite alternate ease-in-out; }
    @keyframes energyRegen { 0% { width: 75%; background-color: #cc3c3c; } 100% { width: 100%; background-color: var(--stardew-green); } }
    .xp-indicator { position: absolute; right: 10px; top: -24px; color: #56db3b; text-shadow: 2px 2px 0 #000; font-weight: bold; animation: xpFloat 2s infinite ease-in-out; }
    @keyframes xpFloat { 0% { transform: translateY(4px); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(-14px); opacity: 0; } }

    /* 下部二栏复合层 */
    .bottom-composite-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; scroll-margin-top: 25px; }
    @media (max-width: 900px) { .bottom-composite-grid { grid-template-columns: 1fr; } }

    /* 日记本 */
    .diary-container-v2 { background: #fbf5eb; border: 4px solid #8a5c36; padding: 25px 20px 20px 20px; position: relative; }
    .diary-title-v2 { font-size: 1.6rem; color: #4a2107; margin: 0; text-align: center; }
    .diary-author { text-align: center; font-size: 0.9rem; margin: 2px 0 14px 0; color: #8c6342; }
    .diary-body-split { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 14px; }
    .diary-text-p { font-size: 0.95rem; line-height: 1.4; color: #301705; font-family: 'Georgia', serif; }
    .diary-hobbies-p { background: #ecdcb9; padding: 10px; border: 2px solid #8a5c36; border-radius: 4px; }
    .hobby-title { margin: 0 0 8px 0; font-size: 1rem; color: #4a2107; }
    .hobby-row { font-size: 0.9rem; margin-bottom: 4px; color: #593113; }

    /* 技能区格子进度条 */
    .skills-pixel-board { background: #eccc9a; border: 4px solid #63320c; padding: 16px; box-shadow: inset -3px -3px 0 #b38e59, inset 3px 3px 0 #fff0d4; }
    .skills-board-header { text-align: center; font-size: 1.4rem; font-weight: bold; color: #3d1b03; border-bottom: 3px solid #63320c; padding-bottom: 8px; margin-bottom: 16px; }
    .skills-list-wrapper { display: flex; flex-direction: column; gap: 12px; }
    .skill-progress-row { display: grid; grid-template-columns: 1.2fr 2fr 0.8fr; align-items: center; background: #f5e4c4; border: 2px solid #82542e; padding: 6px 12px; border-radius: 2px; }
    .skill-name-col { font-weight: bold; color: #381b05; display: flex; align-items: center; gap: 6px; }
    .sk-badge { font-size: 0.9rem; }
    .skill-bar-blocks-col { display: flex; align-items: center; gap: 8px; }
    .skill-tool-icon { font-size: 1.2rem; min-width: 20px; text-align: center; }
    .blocks-group { display: flex; gap: 2px; background: #422006; padding: 2px; flex-grow: 1; }
    .blocks-group .block { flex-grow: 1; height: 18px; background: #735135; box-shadow: inset -1px -1px 0 rgba(0,0,0,0.4); }
    .blocks-group .block.active { background: #e07a34; box-shadow: inset -2px -2px 0 #a14b10, inset 2px 2px 0 #ffb075; }
    .skill-level-col { text-align: right; font-weight: bold; color: #52290a; }

    /* 时间轴与项目卡片 */
    .modal-list-item { display: flex; gap: 16px; background: #fff; border: 2px solid #855329; padding: 16px; margin-top: 16px; }
    .item-emoji { font-size: 2.2rem; display: flex; align-items: center; }
    .modal-timeline { padding-left: 16px; border-left: 4px dashed #855329; }
    .time-block { margin-bottom: 20px; position: relative; }
    .time-badge { background: #e3b073; border: 2px solid #542b0e; padding: 2px 8px; display: inline-block; margin-bottom: 6px; }
</style>

<script>
    const menuCanvas = document.querySelector('.game-main-content');
    const navItems = document.querySelectorAll('.sidebar-item');
    const sections = document.querySelectorAll('.scroll-section');

    navItems.forEach(item => {
        item.addEventListener('click', (e) => {
            const hash = item.getAttribute('href');
            if (hash && hash.startsWith('#')) {
                e.preventDefault();
                const targetSection = document.querySelector(hash);
                
                if (targetSection) {
                    targetSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            }
        });
    });

    if (menuCanvas && 'IntersectionObserver' in window) {
        const observerOptions = {
            root: menuCanvas, 
            rootMargin: '-40px 0px -50% 0px', 
            threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute('id');
                    if (!id) return;

                    navItems.forEach(nav => nav.classList.remove('active-tab'));
                    const activeNav = document.querySelector(`[data-nav="${id}"]`);
                    if (activeNav) activeNav.classList.add('active-tab');
                }
            });
        }, observerOptions);

        sections.forEach(section => observer.observe(section));
    }
</script>